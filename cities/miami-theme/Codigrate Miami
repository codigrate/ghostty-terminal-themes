# Codigrate Miami
#
# Category: Cities
#
# Description:
# Inspired by the electric nights and pastel sunsets of Miami, this theme blends deep purples with vibrant
# neon accents to create a bold yet balanced coding environment. Dark, warm backgrounds ground the editor,
# while vivid pinks, corals, and tropical teals bring energy and clarity to key syntax elements.
#
# For more information about the color theory behind:
# https://codigrate.com

# --- Interface colors ---

# Background uses editorBackground first because Ghostty is a reading surface.
background = #33121D
foreground = #D8D3D4

selection-background = #5D224D
selection-foreground = #D8D3D4

cursor-color = #E17CBF
cursor-text = #270D16

