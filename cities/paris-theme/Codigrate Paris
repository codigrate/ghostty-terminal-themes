# Codigrate Paris
#
# Category: Cities
#
# Description:
# Inspired by elegant boulevards and Paris’s sunset glow, this theme trades bright champagne for dusty
# rose accents over calm plum-espresso tones. Soft dark editor backgrounds keep focus clear, while mauve
# surfaces and wine-tinted hovers add depth and balance, with a gentle blush accent guiding attention
# across the interface.
#
# For more information about the color theory behind:
# https://codigrate.com

# --- Interface colors ---

# Background uses editorBackground first because Ghostty is a reading surface.
background = #281D22
foreground = #DBD7D7

selection-background = #722832
selection-foreground = #DBD7D7

cursor-color = #C38AA4
cursor-text = #100D0E

