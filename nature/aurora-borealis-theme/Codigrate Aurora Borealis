# Codigrate Aurora Borealis
#
# Category: Nature
#
# Description:
# Inspired by the natural phenomena of the Aurora Borealis, this dark theme captures the majesty and mystery
# of the Arctic night sky. Dark blues and teals serve as the backdrop, while lighter accents echo the
# ethereal colors of the Northern Lights. The palette is designed to be easy on the eyes, helping you focus,
# and code efficiently.
#
# For more information about the color theory behind:
# https://codigrate.com

# --- Interface colors ---

# Background uses editorBackground first because Ghostty is a reading surface.
background = #142B37
foreground = #E0E2E3

selection-background = #643C59
selection-foreground = #E0E2E3

cursor-color = #8DC5E1
