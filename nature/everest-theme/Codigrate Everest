# Codigrate Everest
#
# Category: Nature
#
# Description:
# Inspired by the majestic heights and serene landscapes of Mount Everest, this light theme aims to provide a calming and focused coding environment. The soft blues and grays mimic the icy terrains, while subtle hints of warmer colors evoke the golden hues of dawn breaking over snow-capped peaks.
#
# For more information about the color theory behind:
# https://codigrate.com

# --- Interface colors ---

# Background uses editorBackground first because Ghostty is a reading surface.
background = #FDFEFF
foreground = #131B25

selection-background = #D5ECE2
selection-foreground = #131B25

cursor-color = #467196
cursor-text = #FFFFFF

