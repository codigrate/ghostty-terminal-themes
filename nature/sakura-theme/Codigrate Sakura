# Codigrate Sakura
#
# Category: Nature
#
# Description:
# Inspired by cherry blossom season and the quiet gardens beneath it, this theme pairs pale petal backgrounds with deep rose and plum accents to create a soft and unhurried coding environment. Light, gentle surfaces keep the editor calm, while muted greens and clear sky blues add balance and focus to key syntax elements.
#
# For more information about the color theory behind:
# https://codigrate.com

# --- Interface colors ---

# Background uses editorBackground first because Ghostty is a reading surface.
background = #FEFCFC
foreground = #29000D

selection-background = #E7CFDF
selection-foreground = #29000D

cursor-color = #C55EA5
cursor-text = #FFFFFF

